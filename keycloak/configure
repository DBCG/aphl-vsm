#!/bin/bash
# Command used to debug script quickly
# docker rm -f keycloak-keycloak-1 keycloak-postgres-1 && docker volume prune -f && docker-compose up -d && ./configure
# https://github.com/ThisIsRuvos/ersd-keycloak/blob/master/configure
set -e

DIR="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# set defaults if user does not enter anything themselves
base_url=${base_url:-'http://localhost:8080'}
admin_username=${admin_username:-admin}
admin_password=${admin_password:-admin}
non_admin_username=${non_admin_username:-johndoe}
non_admin_pswd=${non_admin_password:-password}

realm=${realm:-aphl}
client=${client:-aphl_app}
redirect_uris=${redirect_uris:-'["http://localhost:3000/api/auth/callback/keycloak"]'}
web_origins=${web_origins:-'["*"]'}
vsm_app_base_url=${vsm_app_base_url:-'http://localhost:3000'}

res=$(curl -sS --data-urlencode 'username='${admin_username} --data-urlencode 'password='${admin_password} -d 'grant_type=password&client_id=admin-cli' -X POST $base_url/realms/master/protocol/openid-connect/token)
token=$(echo $res | jq -r '.access_token')

echo token: $token

if [ $token == null ]; then
echo 'Unable to fetch token.'
echo $res
exit 1
fi
echo -e '\n________________________________\n'
echo -e 'Creating realm '$realm'...'
curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"enabled": true, "id":"'$realm'", "realm":"'$realm'"}' $base_url/admin/realms
echo -e '\n________________________________\n'

echo -e 'Creating client '$client' on realm '$realm'...'
client_id=$(curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"enabled":true,"attributes":{"post.logout.redirect.uris":"'$vsm_app_base_url'"},"webOrigins":'$web_origins',"redirectUris":'$redirect_uris',"clientId":"'$client'","protocol":"openid-connect"}' $base_url/admin/realms/$realm/clients -si | grep 'Location' | awk -F': ' '{print $2}'| awk -F / '{print $NF}' | tr -d '\r')
echo "Created $client with id: $client_id"
echo -e '\n________________________________\n'

echo -e 'Creating Service client 'server_auth' on realm '$realm'...'
server_auth_client_id=$(curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"protocol":"openid-connect","clientId":"server_auth","name":"","description":"","publicClient":false,"authorizationServicesEnabled":false,"serviceAccountsEnabled":true,"implicitFlowEnabled":false,"directAccessGrantsEnabled":true,"standardFlowEnabled":true,"frontchannelLogout":true,"attributes":{"saml_idp_initiated_sso_url_name":"","oauth2.device.authorization.grant.enabled":false,"oidc.ciba.grant.enabled":false},"alwaysDisplayInConsole":false,"rootUrl":"","baseUrl":""}' $base_url/admin/realms/$realm/clients -si | grep 'Location' | awk -F': ' '{print $2}'| awk -F / '{print $NF}' | tr -d '\r')
echo "Created server_auth with id: $server_auth_client_id"
echo -e '\n________________________________\n'

echo -e '\n________________________________\n'
echo -e 'Retrieving and Setting Server Auth Secret...'
server_auth_client_secret=$(curl -H 'Authorization: Bearer '$token $base_url/admin/realms/$realm/clients/$server_auth_client_id/client-secret | jq -r '.value')
sed -i '' "s/^KEYCLOAK_SECRET=.*/KEYCLOAK_SECRET=$server_auth_client_secret/" $DIR/../vsm-app/.env.local
echo "Updated .env.local with server_auth secret"
echo -e '\n________________________________\n'

echo -e '\n________________________________\n'
echo -e 'Updating Server Auth Settings...'
curl -X PUT -H 'Content-Type: application/json' -H 'Authorization: Bearer '$token -d '{"attributes":{"access.token.lifespan": -1}}' $base_url/admin/realms/$realm/clients/$server_auth_client_id

echo -e 'Updating Service User Role Settings...'
realm_management_client_id=$(curl -H 'Authorization: Bearer '$token $base_url/admin/realms/$realm/clients?first=0\&max=101 | jq -r '.[] | select(.clientId == "realm-management").id')
service_account_user_id=$(curl -H 'Authorization: Bearer '$token $base_url/admin/realms/$realm/clients/$server_auth_client_id/service-account-user | jq -r '.id')
echo "service_account_user_id: $service_account_user_id"
manage_users_role_id=$(curl -H 'Authorization: Bearer '$token $base_url/admin/realms/$realm/ui-ext/available-roles/users/$service_account_user_id?first=0\&max=101\&search="" | jq '.[] | select(.role == "manage-users").id')
echo "manage_users_role: $manage_users_role_id" 
echo "realm_management_client_id $realm_management_client_id"
echo "{ \"id\": $manage_users_role_id, \"name\": \"manage-users\",\"description\": \"\${role_manage-users}\" }"
curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d "[{ \"id\": $manage_users_role_id, \"name\": \"manage-users\",\"description\": \"\${role_manage-users}\" }]" $base_url/admin/realms/$realm/users/$service_account_user_id/role-mappings/clients/$realm_management_client_id

echo -e 'Finished updating Server Auth Settings'
echo -e '\n________________________________\n'


##################
## Create Roles ##
##################
### Create Admin role
echo -e '\n________________________________\n'
echo -e 'Creating admin role'
admin_role_url=$(curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"name": "admin"}' $base_url/admin/realms/$realm/clients/$client_id/roles -si | grep 'Location' | awk -F': ' '{print $2}'| tr -d '\r')
echo "url $admin_role_url"
admin_role_id=$(curl -H 'content-type: application/json' -H 'Authorization: Bearer '$token "$admin_role_url" | jq '.id'| tr -d '\r')
echo -e "Created admin role with id: $admin_role_id"
echo -e '\n________________________________\n'

# Create Editor Role
echo -e '\n________________________________\n'
echo -e 'Creating editor role'
editor_role_url=$(curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"name": "editor"}' $base_url/admin/realms/$realm/clients/$client_id/roles -si | grep 'Location' | awk -F': ' '{print $2}'| tr -d '\r')
echo "url $editor_role_url"
editor_role_id=$(curl -H 'content-type: application/json' -H 'Authorization: Bearer '$token "$editor_role_url" | jq '.id'| tr -d '\r')
echo -e "Created editor role with id: $editor_role_id"
echo -e '\n________________________________\n'

# Create Reviewer Role
echo -e '\n________________________________\n'
echo -e 'Creating reviewer role'
reviewer_role_url=$(curl -X POST -H 'content-type: application/json' -H 'Authorization: Bearer '$token -d '{"name": "reviewer"}' $base_url/admin/realms/$realm/clients/$client_id/roles -si | grep 'Location' | awk -F': ' '{print $2}'| tr -d '\r')
echo "url $reviewer_role_url"
reviewer_role_id=$(curl -H 'content-type: application/json' -H 'Authorization: Bearer '$token "$reviewer_role_url" | jq '.id'| tr -d '\r')
echo -e "Created reviewer role with id: $reviewer_role_id"
echo -e '\n________________________________\n'

echo -e 'Fetching authentication certificate for realm '$realm'...'
raw_cert=$(curl -H 'Authorization: Bearer '$token $base_url/admin/realms/$realm/keys | jq -r '.keys[] | select(.algorithm == "RS256").certificate')
echo -e '\n________________________________\n'
echo '-----BEGIN CERTIFICATE-----\n'$raw_cert'\n-----END CERTIFICATE-----'


# Add mapper for scopes
echo -e '\n________________________________\n'
echo -e 'Creating mapper for scopes with this url:' $base_url/admin/realms/$realm/clients/$client_id/protocol-mappers/models
curl --location --request POST $base_url/admin/realms/$realm/clients/$client_id/protocol-mappers/models \
  --header 'Content-Type: application/json' \
  --header "Authorization: Bearer ${token}" \
  --data-raw '{
    "protocol": "openid-connect",
    "protocolMapper": "oidc-usermodel-client-role-mapper",
    "name": "ClientRole",
    "config": {
      "usermodel.clientRoleMapping.rolePrefix": "",
      "claim.name": "resource_access.${client_id}.roles",
      "usermodel.clientRoleMapping.clientId": "aphl_app",
      "multivalued": "true",
      "jsonType.label": "",
      "id.token.claim": "true",
      "access.token.claim": "true",
      "userinfo.token.claim": "true"
    }
  }'
echo -e 'successfully created client role mappings to token'
echo -e '\n________________________________\n'



################################################################
# Create Admin User in app
# https://www.appsdeveloperblog.com/keycloak-rest-api-create-a-new-user/
echo -e 'Creating user for admin role '${non_admin_username}' on realm '$realm'...'
admin_user_id=$(curl -X POST $base_url/admin/realms/$realm/users -si \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '{
  "firstName": "John",
  "lastName": "Doe",
  "email": "johndoe@test.com",
  "enabled": true,
  "username": "'${non_admin_username}'",
  "credentials": [
    {
      "type": "password",
      "value": "'${non_admin_pswd}'",
      "temporary": false
    }
  ]
}'| grep 'Location' | awk -F': ' '{print $2}'| awk -F / '{print $NF}' | tr -d '\r')
echo "sucessfully created admin user with id: $admin_user_id"
echo -e '\n________________________________\n'


# Map user to admin role
echo -e '\n________________________________\n'
echo -e 'Mapping '${non_admin_username}' to role admin'
curl -X POST $base_url/admin/realms/$realm/users/$admin_user_id/role-mappings/realm \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[]'
curl -X POST $base_url/admin/realms/$realm/users/$admin_user_id/role-mappings/clients/$client_id \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[{
    "id": '${admin_role_id}',
    "name": "admin"
}]'
echo "sucessfully mapped user to admin role"
echo -e '\n________________________________\n'


# Create Editor role User
echo -e '\n________________________________\n'
echo -e 'Creating user for editor role '${non_admin_username}'-editor on realm '$realm'...'
editor_user_id=$(curl -X POST $base_url/admin/realms/$realm/users -si \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '{
  "firstName": "gary",
  "lastName": "hale",
  "email": "garyhale@test.com",
  "enabled": true,
  "username": "gary",
  "credentials": [
    {
      "type": "password",
      "value": "'${non_admin_pswd}'",
      "temporary": false
    }
  ]
}' | grep 'Location' | awk -F': ' '{print $2}'| awk -F / '{print $NF}' | tr -d '\r')
echo "Created user '${non_admin_username}-editor with user_id: $editor_user_id"
echo -e '\n________________________________\n'


# Map new user to editor role
echo -e '\n________________________________\n'
echo -e 'Mapping '${non_admin_username}'-editor to role editor'

curl -X POST $base_url/admin/realms/$realm/users/$editor_user_id/role-mappings/realm \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[]'
curl -X POST $base_url/admin/realms/$realm/users/$editor_user_id/role-mappings/clients/$client_id \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[{
    "id": '${editor_role_id}',
    "name": "editor"
}]'

echo 'successfully mapped user to role editor'
echo -e '\n________________________________\n'


# Create Reviewer role User
echo -e '\n________________________________\n'
echo -e 'Creating user for reviewer role '${non_admin_username}'-reviewer on realm '$realm'...'
reviewer_user_id=$(curl -X POST $base_url/admin/realms/$realm/users -si \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '{
  "firstName": "Joy",
  "lastName": "bennet",
  "email": "Joybennet@test.com",
  "enabled": true,
  "username": "joybennet",
  "credentials": [
    {
      "type": "password",
      "value": "'${non_admin_pswd}'",
      "temporary": false
    }
  ]
}' | grep 'Location' | awk -F': ' '{print $2}'| awk -F / '{print $NF}' | tr -d '\r')
echo "Created user '${non_admin_username}-reviewer with user_id: $reviewer_user_id"
echo -e '\n________________________________\n'


# Map new user to reviewer role
echo -e '\n________________________________\n'
echo -e 'Mapping '${non_admin_username}'-reviewer to role reviewer'

curl -X POST $base_url/admin/realms/$realm/users/$reviewer_user_id/role-mappings/realm \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[]'
curl -X POST $base_url/admin/realms/$realm/users/$reviewer_user_id/role-mappings/clients/$client_id \
--header 'Content-Type: application/json' \
--header "Authorization: Bearer ${token}" \
--data-raw '[{
    "id": '${reviewer_role_id}',
    "name": "reviewer"
}]'

echo 'successfully mapped user to role reviewer'
echo -e '\n________________________________\n'

echo -e "Finished running setup script\n----------------------------------------------------------------"